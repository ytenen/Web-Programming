<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="PU" transaction-type="JTA">
        <class>model.Result</class>
        <properties>
            <!-- JDBC configuration -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5678/studs"/>
            <property name="jakarta.persistence.jdbc.user" value="bubu"/>
            <property name="jakarta.persistence.jdbc.password" value="bebe"/>

            <!-- EclipseLink specific properties -->
            <property name="eclipselink.logging.level" value="FINE"/>
            <property name="eclipselink.ddl-generation" value="create-tables"/>
            <property name="eclipselink.target-server" value="JakartaEE"/>
        </properties>
    </persistence-unit>
</persistence>
